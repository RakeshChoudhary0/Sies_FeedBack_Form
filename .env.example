# =============================================================================
# Syllabus Feedback System - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Connection (RECOMMENDED)
# -----------------------------------------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> Database
#
# Option A: Transaction Pooler Connection String (Best for FastAPI, port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Direct Connection String (port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Option C: Individual Database Parameters
# DB_HOST=db.[PROJECT-REF].supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=[YOUR-PASSWORD]
# DB_NAME=postgres

# -----------------------------------------------------------------------------
# 2. Supabase API Credentials (Optional, for Supabase Python SDK / Storage)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# -----------------------------------------------------------------------------
# 3. Security & Admin Authentication
# -----------------------------------------------------------------------------
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_USERNAME=
ADMIN_PASSWORD=

